      "kind": "nav",
      "refersTo": "queue-tab-selected",
      "description": "Trilho segmentado com contadores; pendentes em âmbar.",
      "html": "<div class=\"ds-abas\"><button class=\"ds-aba\" aria-selected=\"true\">Pendentes <span class=\"ds-n ds-tem\">3</span></button><button class=\"ds-aba\">Aprovados <span class=\"ds-n\">12</span></button><button class=\"ds-aba\">Recusados <span class=\"ds-n\">2</span></button></div>",
      "css": ".ds-abas{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;padding:3px;background:#f3f4f7;border-radius:8px;width:320px;font:600 12.5px ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-aba{border:0;background:transparent;height:30px;border-radius:6px;font:inherit;color:#505767;display:inline-flex;align-items:center;justify-content:center;gap:5px;cursor:pointer;transition:background-color .15s,color .15s}.ds-aba:hover{color:#151821}.ds-aba:focus-visible{outline:2px solid #00288E;outline-offset:2px}.ds-aba[aria-selected=\"true\"]{background:#fff;color:#151821;box-shadow:0 1px 2px rgba(16,24,40,.1)}.ds-n{font-size:11px;font-weight:700;padding:1px 5px;border-radius:99px;background:#e3e5eb;color:#505767}.ds-tem{background:#fdf3e2;color:#b45309}"
    },
