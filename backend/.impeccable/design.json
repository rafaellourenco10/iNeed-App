      "css": ".ds-item{width:320px;display:grid;grid-template-columns:36px 1fr auto;gap:10px;align-items:center;text-align:left;padding:10px;border:0;border-radius:8px;background:transparent;font:14px/1.45 ui-sans-serif,system-ui,sans-serif;color:#151821;cursor:pointer;transition:background-color .12s}.ds-item:hover{background:#f8f9fb}.ds-item:focus-visible{outline:2px solid #00288E;outline-offset:2px}.ds-item b{display:block;font-weight:600}.ds-item small,.ds-item time{display:block;font-size:12px;color:#5f6676}.ds-item time{align-self:start}.ds-av{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:13px;background:#e6e9f0;color:#505767}.ds-item[aria-current=\"true\"]{background:#e8edfa}.ds-item[aria-current=\"true\"] b{color:#00288E}.ds-item[aria-current=\"true\"] .ds-av{background:#00288E;color:#fff}"
